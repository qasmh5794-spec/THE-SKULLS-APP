rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             (!('email' in data) || data.email is string) &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             (!('gamerTag' in data) || data.gamerTag is string) &&
             (!('favoritePlatform' in data) || data.favoritePlatform is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidReviewLike(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.reviewId is string &&
             data.reviewId.size() > 0 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidReviewComment(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.reviewId is string &&
             data.reviewId.size() > 0 &&
             data.userName is string &&
             data.userName.size() > 0 &&
             data.comment is string &&
             data.comment.size() > 0 &&
             data.comment.size() <= 1000 &&
             (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 10)) &&
             (!('gamerTag' in data) || data.gamerTag is string) &&
             (!('userPhoto' in data) || data.userPhoto is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;
    }

    // Review Likes
    match /reviews/{reviewId}/likes/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidReviewLike(request.resource.data);
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // Review Comments
    match /reviews/{reviewId}/comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidReviewComment(request.resource.data);
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidReviewComment(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
